# /etc/husky.env  (chmod 600 — внутри токен бота)
BOT_TOKEN=123456:AA...
# адрес мини-приложения, он же идёт в кнопку бота
WEBAPP_URL=https://husky-mark.duckdns.org/
# тот же origin без слэша: включает режим webhook вместо long polling
WEBHOOK_BASE=https://husky-mark.duckdns.org
HOST=127.0.0.1
PORT=8080
DB_PATH=/var/lib/husky/husky.db
GAME_FILE=/srv/husky/index.html
